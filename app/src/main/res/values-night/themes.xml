<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark variant of the Activity host theme. The window background is
      midnight indigo to match the Compose dark scheme and avoid a
      white flash on cold start.
    -->
    <style name="Theme.SpendAi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/spendai_window_background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
