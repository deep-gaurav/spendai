<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions

  - RECEIVE_SMS / READ_SMS: Android treats these as "dangerous" permissions
    (group: SMS). On Android 6.0 (API 23) and above, they must be requested at
    runtime via ActivityCompat.requestPermissions() before the receiver will
    actually fire. Phase 1 has no UI, so the permissions are declared but the
    consent screen is a Phase 1.5 follow-up.

  - POST_NOTIFICATIONS: required on Android 13 (API 33) to surface any future
    "parsing failed" or "model ready" status notifications. Harmless on older
    versions.

  - INTERNET: needed by the Phase 1.5 onboarding flow to download the
    .litertlm model from HuggingFace. After onboarding completes, the app
    can run fully offline; the permission is declared and not revoked so
    future releases can update the model in place.

  Native libraries

  The <uses-native-library> entries below are MANDATORY for the GPU backend
  on Android. LiteRT-LM ships its own OpenCL/Vulkan JNI shims; declaring
  them with android:required="false" lets the app fall through to CPU on
  devices where the GPU driver is unavailable.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SpendAiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpendAi"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        tools:targetApi="34">

        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <!--
          Google AI Edge Gallery (the reference on-device LLM app) declares
          these two system libraries too. On Tensor devices (Pixel 8+)
          libedgetpu_litert.so is the Edge TPU delegate that Backend.NPU
          resolves to. On Snapdragon devices libcdsprpc.so is the Hexagon
          DSP RPC bridge that the QNN NPU delegate loads. Both are
          required="false" so devices without them still install; the
          engine just falls through to the next backend in the chain.
          Reference: github.com/google-ai-edge/gallery AndroidManifest.xml
        -->
        <uses-native-library android:name="libedgetpu_litert.so" android:required="false" />
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />

        <!--
          Phase 1.5 onboarding entry point. Hosts the Compose nav graph:
          permissions -> model download -> model test -> home.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SpendAi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          SMS receiver.

          android:exported="true" is required from Android 12+ to receive
          system broadcasts. The android:permission attribute restricts
          who can deliver this broadcast to *only* the system, which
          prevents malicious apps from forging SMS_RECEIVED intents.
        -->
        <service
            android:name=".service.IngestionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Exposes exported Tracking backup JSON files (see
          TrackingBackupManager) as content:// Uris so they can be
          shared or opened by other apps without granting broader
          file access. Scoped to the "backups" subfolder only via
          res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
